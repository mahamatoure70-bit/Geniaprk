              value={email}
              onChange={(e) => setEmail(e.target.value)}
              className="w-full bg-studio-panel border border-studio-line rounded-sm px-3 py-2.5 text-sm"
            />
          </div>
          <div>
            <label className="font-mono text-xs text-studio-paper/50 block mb-1.5">MOT DE PASSE</label>
            <input
              type="password"
              required
              minLength={8}
