        <p className="text-center text-sm text-studio-paper/50 mt-6">
          Déjà un compte ?{" "}
          <Link href="/login" className="text-tally hover:underline">
            Se connecter
          </Link>
        </p>
      </div>
    </main>
  );"use client";

import { useState, useEffect } from "react";
import { useSession } from "next-auth/react";
import { useRouter } from "next/navigation";

type GenType = "image" | "video" | "music";
type Platform = "tiktok" | "youtube" | "instagram" | "pinterest";

const MODELS: Record<GenType, { id: string; label: string; cost: number }[]> = {
  image: [
    { id: "flux-pro", label: "Flux Pro — photoréaliste", cost: 4 },
    { id: "ideogram-v3", label: "Ideogram v3 — typographie & design", cost: 5 },
  ],
  video: [
    { id: "kling-2.1", label: "Kling 2.1 — qualité/coût", cost: 25 },
    { id: "runway-gen4", label: "Runway Gen-4 — haut de gamme", cost: 35 },
  ],
  music: [{ id: "elevenlabs-music", label: "ElevenLabs Music", cost: 10 }],
};

const PLATFORMS: { id: Platform; label: string }[] = [
  { id: "tiktok", label: "TikTok" },
  { id: "youtube", label: "YouTube" },
  { id: "instagram", label: "Instagram" },
  { id: "pinterest", label: "Pinterest" },
];

interface GenerationResult {
  id: string;
  status: string;
  resultUrl?: string;
  type: GenType;
}

export default function DashboardPage() {
  const { status } = useSession();
  const router = useRouter();
  const [type, setType] = useState<GenType>("video");
  const [platform, setPlatform] = useState<Platform>("tiktok");
  const [model, setModel] = useState(MODELS.video[0].id);
  const [prompt, setPrompt] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [results, setResults] = useState<GenerationResult[]>([]);
  const [credits, setCredits] = useState<number | null>(null);

  useEffect(() => {
    if (status === "unauthenticated") router.push("/login");
  }, [status, router]);

  useEffect(() => {
    if (status !== "authenticated") return;
    fetch("/api/me")
      .then((r) => r.json())
      .then((d) => setCredits(d.user?.credits ?? null))
      .catch(() => {});
  }, [status]);

  function selectType(t: GenType) {
    setType(t);
    setModel(MODELS[t][0].id);
  }

  async function handleGenerate() {
    if (prompt.trim().length < 3) {
      setError("Décrivez ce que vous voulez générer (3 caractères minimum).");
      return;
    }
    setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ type, model, prompt, platform }),
      });
      const data = await res.json();
      if (!res.ok) {
        setError(data.error ?? "Une erreur est survenue.");
        return;
      }
      setResults((prev) => [data.generation, ...prev]);
      setCredits((prev) => (prev !== null ? prev - selectedCost : prev));
    } catch {
      setError("Impossible de contacter le serveur.");
    } finally {
      setLoading(false);
    }
  }

  const selectedCost = MODELS[type].find((m) => m.id === model)?.cost ?? 0;

  return (
    <main className="min-h-screen bg-studio-bg text-studio-paper">
      <header className="border-b border-studio-line">
        <div className="mx-auto max-w-5xl px-6 py-5 flex items-center justify-between">
          <span className="font-display text-xl">RUSHES</span>
          <div className="font-mono text-sm text-studio-paper/70">
            {credits !== null ? `${credits} crédits` : "— crédits"}
          </div>
        </div>
      </header>

      <div className="mx-auto max-w-5xl px-6 py-10 grid lg:grid-cols-[380px_1fr] gap-10">
        <div className="space-y-6">
          <div>
            <p className="font-mono text-xs text-studio-paper/50 mb-2">TYPE DE CONTENU</p>
            <div className="flex gap-2">
              {(["video", "image", "music"] as GenType[]).map((t) => (
                <button
                  key={t}
                  onClick={() => selectType(t)}
                  className={`flex-1 py-2.5 rounded-sm border font-mono text-sm capitalize transition-colors ${
                    type === t
                      ? "border-tally text-tally bg-tally/10"
                      : "border-studio-line text-studio-paper/60 hover:border-studio-paper/40"
                  }`}
                >
                  {t === "video" ? "Vidéo" : t === "image" ? "Image" : "Musique"}
                </button>
              ))}
            </div>
          </div>

          <div>
            <p className="font-mono text-xs text-studio-paper/50 mb-2">PLATEFORME CIBLE</p>
            <div className="grid grid-cols-2 gap-2">
              {PLATFORMS.map((p) => (
                <button
                  key={p.id}
                  onClick={() => setPlatform(p.id)}
                  className={`py-2.5 rounded-sm border font-mono text-sm transition-colors ${
                    platform === p.id
                      ? "border-tally text-tally bg-tally/10"
                      : "border-studio-line text-studio-paper/60 hover:border-studio-paper/40"
                  }`}
                >
                  {p.label}
                </button>
              ))}
            </div>
          </div>

          <div>
            <p className="font-mono text-xs text-studio-paper/50 mb-2">MODÈLE</p>
            <select
              value={model}
              onChange={(e) => setModel(e.target.value)}
              className="w-full bg-studio-panel border border-studio-line rounded-sm px-3 py-2.5 text-sm"
            >
              {MODELS[type].map((m) => (
                <option key={m.id} value={m.id}>
                  {m.label} — {m.cost} crédits
                </option>
              ))}
            </select>
          </div>

          <div>
            <p className="font-mono text-xs text-studio-paper/50 mb-2">PROMPT</p>
            <textarea
              value={prompt}
              onChange={(e) => setPrompt(e.target.value)}
              rows={5}
              placeholder="Ex : Plan rapproché d'un café qui coule dans une tasse en céramique, lumière du matin, ambiance chaleureuse..."
              className="w-full bg-studio-panel border border-studio-line rounded-sm px-3 py-2.5 text-sm resize-none placeholder:text-studio-paper/30"
            />
          </div>

          {error && <p className="text-tally text-sm font-mono">{error}</p>}

          <button
            onClick={handleGenerate}
            disabled={loading}
            className="w-full bg-tally text-studio-bg font-medium py-3 rounded-sm hover:bg-tally/90 disabled:opacity-50 transition-colors"
          >
            {loading ? "Génération en cours..." : `Générer — ${selectedCost} crédits`}
          </button>
        </div>

        <div>
          <p className="font-mono text-xs text-studio-paper/50 mb-4">RÉSULTATS</p>
          {results.length === 0 ? (
            <div className="border border-dashed border-studio-line rounded-sm h-64 flex items-center justify-center text-studio-paper/30 text-sm">
              Vos générations apparaîtront ici
            </div>
          ) : (
            <div className="grid sm:grid-cols-2 gap-4">
              {results.map((r) => (
                <div key={r.id} className="border border-studio-line rounded-sm p-3">
                  <p className="font-mono text-xs text-studio-paper/50 mb-2">{r.status}</p>
                  {r.resultUrl ? (
                    r.type === "video" ? (
                      <video src={r.resultUrl} controls className="w-full rounded-sm" />
                    ) : r.type === "music" ? (
                      <audio src={r.resultUrl} controls className="w-full" />
                    ) : (
                      <img src={r.resultUrl} alt="Résultat généré" className="w-full rounded-sm" />
                    )
                  ) : (
                    <p className="text-studio-paper/40 text-sm">En attente...</p>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </main>
  );
}"use client";

import { useState } from "react";

const PACKS = [
  { id: "pack_s", credits: 50, priceXof: 4000, label: "Starter" },
  { id: "pack_m", credits: 150, priceXof: 10000, label: "Creator" },
  { id: "pack_l", credits: 400, priceXof: 25000, label: "Studio" },
];

export default function PricingPage() {
  const [loadingPack, setLoadingPack] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);

  async function buy(packId: string) {
    setLoadingPack(packId);
    setError(null);
    try {
      const res = await fetch("/api/fedapay/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ packId }),
      });
      const data = await res.json();
      if (!res.ok) {
        setError(data.error ?? "Erreur lors de la création du paiement.");
        return;
      }
      window.location.href = data.paymentUrl;
    } catch {
      setError("Impossible de contacter le serveur.");
    } finally {
      setLoadingPack(null);
    }
  }

  return (
    <main className="min-h-screen bg-studio-bg text-studio-paper">
      <div className="mx-auto max-w-4xl px-6 py-16">
        <h1 className="font-display text-4xl mb-3">Packs de crédits</h1>
        <p className="text-studio-paper/60 mb-10">
          Paiement sécurisé via FedaPay. Les crédits sont ajoutés automatiquement après confirmation.
        </p>

        {error && <p className="text-tally text-sm font-mono mb-6">{error}</p>}

        <div className="grid sm:grid-cols-3 gap-6">
          {PACKS.map((p) => (
            <div key={p.id} className="border border-studio-line rounded-sm p-6 flex flex-col">
              <p className="font-mono text-xs text-studio-paper/50">{p.label.toUpperCase()}</p>
              <p className="font-display text-3xl mt-3">{p.credits} crédits</p>
              <p className="text-studio-paper/60 text-sm mt-1">{p.priceXof.toLocaleString("fr-FR")} FCFA</p>
              <button
                onClick={() => buy(p.id)}
                disabled={loadingPack === p.id}
                className="mt-6 bg-tally text-studio-bg font-medium py-2.5 rounded-sm hover:bg-tally/90 disabled:opacity-50 transition-colors"
              >
                {loadingPack === p.id ? "Redirection..." : "Acheter"}
              </button>
            </div>
          ))}
        </div>
      </div>
    </main>
  );
}
}
