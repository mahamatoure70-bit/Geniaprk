import crypto from "crypto";
import { prisma } from "@/lib/prisma";
import { verifyFedaPayTransaction } from "@/lib/fedapay";
import { creditAfterPayment } from "@/lib/credits";

const WEBHOOK_SECRET = process.env.FEDAPAY_WEBHOOK_SECRET;

function isValidSignature(rawBody: string, signatureHeader: string | null): boolean {
  if (!WEBHOOK_SECRET || !signatureHeader) return false;
  const expected = crypto.createHmac("sha256", WEBHOOK_SECRET).update(rawBody).digest("hex");
  try {
    return crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(signatureHeader));
  } catch {
    return false;
  }
}

export async function POST(req: NextRequest) {
  const rawBody = await req.text();
  const signature = req.headers.get("x-fedapay-signature");

  if (!isValidSignature(rawBody, signature)) {
    return NextResponse.json({ error: "Signature invalide" }, { status: 401 });
  }

  const event = JSON.parse(rawBody);
  const transactionId = String(event?.entity?.id ?? event?.data?.id ?? "");
  if (!transactionId) return NextResponse.json({ error: "Payload invalide" }, { status: 400 });

  const transaction = await verifyFedaPayTransaction(transactionId);

  const payment = await prisma.payment.findUnique({ where: { fedapayTransactionId: transactionId } });
  if (!payment) return NextResponse.json({ error: "Paiement inconnu" }, { status: 404 });

  if (payment.status === "approved") {
    return NextResponse.json({ ok: true });
  }

  if (transaction.status === "approved") {
    await prisma.payment.update({ where: { id: payment.id }, data: { status: "approved" } });
    await creditAfterPayment({
      userId: payment.userId,
      credits: payment.creditsGranted,
      fedapayTransactionId: transactionId,
    });
  } else if (["declined", "canceled"].includes(transaction.status)) {
    await prisma.payment.update({ where: { id: payment.id }, data: { status: transaction.status } });
  }

  return NextResponse.json({ ok: true });
}
}
