export class InsufficientCreditsError extends Error {
  constructor() {
    super("Crédits insuffisants");
    this.name = "InsufficientCreditsError";
  }
}

export async function debitCreditsForGeneration(params: {
  userId: string;
  type: GenerationType;
  modelUsed: string;
  prompt: string;
  platform?: string;
  cost: number;
}) {
  const { userId, type, modelUsed, prompt, platform, cost } = params;

  return prisma.$transaction(async (tx) => {
    const user = await tx.user.findUniqueOrThrow({ where: { id: userId } });
    if (user.credits < cost) throw new InsufficientCreditsError();

    await tx.user.update({
      where: { id: userId },
      data: { credits: { decrement: cost } },
    });

    const generation = await tx.generation.create({
      data: {
        userId,
        type,
        platform,
        prompt,
        modelUsed,
        creditsCost: cost,
        status: "pending",
      },
    });

    await tx.creditTransaction.create({
      data: {
        userId,
        amount: -cost,
        reason: "generation",
        reference: generation.id,
      },
    });

    return generation;
  });
}

export async function refundCreditsForFailedGeneration(generationId: string) {
  return prisma.$transaction(async (tx) => {
    const gen = await tx.generation.update({
      where: { id: generationId },
      data: { status: "failed" },
    });

    await tx.user.update({
      where: { id: gen.userId },
      data: { credits: { increment: gen.creditsCost } },
    });

    await tx.creditTransaction.create({
      data: {
        userId: gen.userId,
        amount: gen.creditsCost,
        reason: "refund",
        reference: gen.id,
      },
    });
  });
}

export async function creditAfterPayment(params: {
  userId: string;
  credits: number;
  fedapayTransactionId: string;
}) {
  const { userId, credits, fedapayTransactionId } = params;
  return prisma.$transaction(async (tx) => {
    await tx.user.update({
      where: { id: userId },
      data: { credits: { increment: credits } },
    });
    await tx.creditTransaction.create({
      data: {
        userId,
        amount: credits,
        reason: "purchase",
        reference: fedapayTransactionId,
      },
    });
  });
import axios from "axios";

const FAL_KEY = process.env.FAL_API_KEY;
const FAL_BASE_URL = "https://fal.run";

export const PLATFORM_PRESETS = {
  tiktok: { width: 1080, height: 1920, aspect: "9:16" },
  instagram: { width: 1080, height: 1920, aspect: "9:16" },
  youtube: { width: 1920, height: 1080, aspect: "16:9" },
  pinterest: { width: 1000, height: 1500, aspect: "2:3" },
} as const;

type PlatformKey = keyof typeof PLATFORM_PRESETS;

async function falRequest(modelPath: string, input: Record<string, unknown>) {
  if (!FAL_KEY) throw new Error("FAL_API_KEY manquante côté serveur");

  const { data } = await axios.post(`${FAL_BASE_URL}/${modelPath}`, input, {
    headers: {
      Authorization: `Key ${FAL_KEY}`,
      "Content-Type": "application/json",
    },
    timeout: 120_000,
  });
  return data;
}

export async function generateImage(prompt: string, platform?: PlatformKey) {
  const preset = platform ? PLATFORM_PRESETS[platform] : PLATFORM_PRESETS.instagram;
  const result = await falRequest("fal-ai/flux-pro/v1.1", {
    prompt,
    image_size: { width: preset.width, height: preset.height },
  });
  return result.images?.[0]?.url as string;
}

export async function generateVideo(prompt: string, platform?: PlatformKey) {
  const preset = platform ? PLATFORM_PRESETS[platform] : PLATFORM_PRESETS.tiktok;
  const result = await falRequest("fal-ai/kling-video/v2.1/standard/text-to-video", {
    prompt,
    aspect_ratio: preset.aspect,
    duration: "5",
  });
  return result.video?.url as string;
}

export async function generateMusic(prompt: string) {
  const result = await falRequest("fal-ai/elevenlabs/music", {
    prompt,
    duration_seconds: 30,
  });
  return result.audio?.url as string;
}
import axios from "axios";

const FEDAPAY_SECRET_KEY = process.env.FEDAPAY_SECRET_KEY;
const FEDAPAY_BASE_URL =
  process.env.FEDAPAY_ENV === "live"
    ? "https://api.fedapay.com/v1"
    : "https://sandbox-api.fedapay.com/v1";

const client = axios.create({
  baseURL: FEDAPAY_BASE_URL,
  headers: {
    Authorization: `Bearer ${FEDAPAY_SECRET_KEY}`,
    "Content-Type": "application/json",
  },
});

export async function createFedaPayTransaction(params: {
  amountXof: number;
  description: string;
  customerEmail: string;
  callbackUrl: string;
}) {
  const { amountXof, description, customerEmail, callbackUrl } = params;

  const { data } = await client.post("/transactions", {
    description,
    amount: amountXof,
    currency: { iso: "XOF" },
    callback_url: callbackUrl,
    customer: { email: customerEmail },
  });

  const transactionId = data.transaction.id;

  const tokenRes = await client.post(`/transactions/${transactionId}/token`);
  const paymentUrl = tokenRes.data.token.url as string;

  return { transactionId, paymentUrl };
}

export async function verifyFedaPayTransaction(transactionId: string) {
  const { data } = await client.get(`/transactions/${transactionId}`);
  return data.transaction as { id: number; status: string; amount: number };
}
